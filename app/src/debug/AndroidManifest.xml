<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb send commands for testing. Never present in release APKs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.nikhilbhatt.hukum.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
